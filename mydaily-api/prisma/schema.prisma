generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserAccountType {
  FREE
  PREMIUM
}

enum UserRole {
  USER
  ADMIN
}

model User {
  google_id    String?         @unique
  id           String          @id @default(uuid()) @db.Char(36)
  email        String          @unique @db.VarChar(255)
  password     String          @db.VarChar(255)
  name         String          @db.VarChar(100)
  avatar_url   String?         @db.VarChar(500)
  account_type UserAccountType @default(FREE)

  role         UserRole        @default(USER)
  is_banned    Boolean         @default(false)
  banned_at    DateTime?       @db.DateTime(0)

  created_at   DateTime        @default(now()) @db.DateTime(0)
  deleted_at   DateTime?       @db.DateTime(0)

  tasks    Task[]
  expenses Expense[]
  budgets  Budget[]

  streak   UserStreak? // ✅ NEW

  @@map("users")
}

model Task {
  id           String    @id @default(uuid()) @db.Char(36)
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  is_completed Boolean   @default(false)
  due_date     DateTime? @db.Date

  completed_at DateTime? @db.DateTime(0) // ✅ NEW: thời điểm hoàn thành
  updated_at   DateTime  @updatedAt @db.DateTime(0) // ✅ optional but good

  user_id String @db.Char(36)
  user    User   @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@index([user_id, is_completed])
  @@index([user_id, completed_at]) // ✅ giúp query theo ngày
  @@map("tasks")
}

model Category {
  id         String    @id @db.Char(36)
  user_id    String    @db.Char(36)
  name       String    @db.VarChar(100)
  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)
  expenses   Expense[]

  @@unique([user_id, name], name: "user_id_name")
  @@index([user_id])
  @@index([user_id, deleted_at])
  @@map("category")
}

model Expense {
  id           String   @id @default(uuid()) @db.Char(36)
  amount       Decimal  @db.Decimal(12, 2)
  expense_date DateTime @db.Date
  note         String?  @db.Text

  user_id     String @db.Char(36)
  category_id String @db.Char(36)

  user     User     @relation(fields: [user_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@map("expenses")
}

model Budget {
  id           String  @id @default(uuid()) @db.Char(36)
  limit_amount Decimal @db.Decimal(12, 2)
  month        Int
  year         Int

  user_id String @db.Char(36)
  user    User   @relation(fields: [user_id], references: [id])

  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@unique([user_id, month, year], name: "user_id_month_year")
  @@map("budgets")
}

model UserStreak {
  user_id          String   @id @db.Char(36)
  current_streak   Int      @default(0)
  longest_streak   Int      @default(0)
  last_streak_date DateTime? @db.Date // ✅ ngày gần nhất “chốt streak”

  updated_at       DateTime @updatedAt @db.DateTime(0)
  created_at       DateTime @default(now()) @db.DateTime(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}
